{
  "mcpServers": {
    "r-btw": {
      "type": "stdio",
      "command": "Rscript",
      "args": [
        "-e",
        "btw::btw_mcp_server(tools=btw::btw_tools(c('cran','docs','pkg','env','run','sessioninfo','ide')))"
      ],
      "env": {},
      "directTools": true
    },
    "vscode-mcp-server": {
      "command": "npx",
      "args": [
        "mcp-remote@next",
        "http://localhost:3400/mcp",
        "--header",
        "Authorization:Bearer hello"
      ],
      "directTools": true
    }
  }
}
