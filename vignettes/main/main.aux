\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scores for 1,000 simulated estimators against the ratio of typical reported standard deviation to error standard deviation. Each point summarises 1,000 forecasts. Colour shows absolute bias for mean CRPS (A) and baseline distance (B), and the coefficient of variation of reported spread (a measure of spread-skill decoupling) for the adjusted unsigned (C) and directed (D) statistics. A ratio below one denotes overconfidence in the typical width.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:metrics}{{1}{6}{Scores for 1,000 simulated estimators against the ratio of typical reported standard deviation to error standard deviation. Each point summarises 1,000 forecasts. Colour shows absolute bias for mean CRPS (A) and baseline distance (B), and the coefficient of variation of reported spread (a measure of spread-skill decoupling) for the adjusted unsigned (C) and directed (D) statistics. A ratio below one denotes overconfidence in the typical width}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Sample size and rejection rates}{7}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sampling variation by reported width, location bias and number of independent predictions. Rows give the baseline (A), directed (B) and adjusted unsigned (C) statistics. Columns give sample size. Boxes summarise 100 replicates for each combination. Dashed lines are marginal 5\% large-sample rejection thresholds.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:limits}{{2}{8}{Sampling variation by reported width, location bias and number of independent predictions. Rows give the baseline (A), directed (B) and adjusted unsigned (C) statistics. Columns give sample size. Boxes summarise 100 replicates for each combination. Dashed lines are marginal 5\% large-sample rejection thresholds}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Baseline (A), directed (B) and adjusted unsigned (C) statistics over ten sample sizes. Each solid line is the median of 250 replicate estimators and shading covers their central 95\%. The four scenarios are correct forecasts, a common location shift, overconfidence, and a correctly centred forecast with independently varying reported spread. Dashed lines give the reference thresholds.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:curves}{{3}{9}{Baseline (A), directed (B) and adjusted unsigned (C) statistics over ten sample sizes. Each solid line is the median of 250 replicate estimators and shading covers their central 95\%. The four scenarios are correct forecasts, a common location shift, overconfidence, and a correctly centred forecast with independently varying reported spread. Dashed lines give the reference thresholds}{figure.3}{}}
\citation{cori2013,thompson2019}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Interpretation of the three scores}{10}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Estimating the reproduction number in simulated epidemics}{10}{section.5}\protected@file@percent }
\newlabel{sec:epi}{{5}{10}{}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces EpiEstim estimates scored against the simulated reproduction number. Each point is a summary of one estimate from 100 independent epidemics for each of 2, 4, 7, 10 and 14 day EpiEstim windows. Epidemic size is given on the x-axis as maximum peak observed daily cases. Panels show mean bias (predictive median - reference, panel A; lower is better), baseline Wasserstein distance (panel B; lower is better), directed statistic (panel C; negative is too conservative, positive overconfident) and adjusted unsigned distance (panel D; lower is better). Lines are local regression smooths. In B--D, the dashed line(s) represents the 5\% significance levels under independence. We interpret the scores and smooths descriptively.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:epi}{{4}{11}{EpiEstim estimates scored against the simulated reproduction number. Each point is a summary of one estimate from 100 independent epidemics for each of 2, 4, 7, 10 and 14 day EpiEstim windows. Epidemic size is given on the x-axis as maximum peak observed daily cases. Panels show mean bias (predictive median - reference, panel A; lower is better), baseline Wasserstein distance (panel B; lower is better), directed statistic (panel C; negative is too conservative, positive overconfident) and adjusted unsigned distance (panel D; lower is better). Lines are local regression smooths. In B--D, the dashed line(s) represents the 5\% significance levels under independence. We interpret the scores and smooths descriptively}{figure.4}{}}
